# Copy to .env and fill in only the values you actually have.
# Leave any of these blank/unset -- the platform will correctly report
# the related telemetry as "unavailable" rather than fabricating it.

# Defaults to a local SQLite file. Point this at the docker-compose Postgres
# instance to use Postgres instead -- no code changes required.
# DATABASE_URL=postgresql+psycopg2://enterprise_ai:enterprise_ai@localhost:5432/enterprise_ai
DATABASE_URL=sqlite:///./enterprise_ai.db

SECRET_KEY=change-this-in-any-real-deployment

# Only used by the OpenAI/Claude/Gemini connectors' own attributable-cost
# tracking (see connectors/providers.py docstring for the honest scope of
# what these connectors can and cannot legitimately report).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Enables the GitHub connector to read commit/PR activity for a configured
# repository (integration point -- see app/connectors/providers.py).
GITHUB_TOKEN=
